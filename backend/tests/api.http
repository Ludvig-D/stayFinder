PATCH {{baseUrl}}/bookings/{{saraBooking.id}}
Content-Type: application/json

{ "status": "cancelled" }

### Book the exact dates of the cancelled booking -> 201, total_price 4400 (VG2: cancelled bookings don't block dates)
# @name rebooked
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 61 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 65 d}}", "guests": 3 }

### Sara deletes the cancelled booking -> 204
DELETE {{baseUrl}}/bookings/{{saraBooking.id}}

### Sara deletes the new booking on the same dates -> 204
DELETE {{baseUrl}}/bookings/{{rebooked.id}}

### Sara deletes the fake-price booking -> 204
DELETE {{baseUrl}}/bookings/{{pricedBooking.id}}

### Log out sara -> 204
POST {{baseUrl}}/auth/logout

