POST {{baseUrl}}/auth/logout

###
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "anna@stayfinder.test",
  "password": "password123"
}

### Anna books Malmö on sara's check-out day -> 201 (VG2: check-out day is free, '[)')
# @name annaBooking
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "anna@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 65 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 67 d}}", "guests": 2 }

### FAIL: anna books dates inside sara's booking -> 409 (VG2)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "anna@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 62 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 63 d}}", "guests": 2 }

### FAIL: anna moves her booking one day earlier, into sara's -> 409 (VG2 on edit)
PATCH {{baseUrl}}/bookings/{{annaBooking.id}}
Content-Type: application/json

{ "check_in": "{{$datetime "YYYY-MM-DD" 64 d}}" }

### Anna sees only her own booking on Malmö, not sara's -> 200, one booking (VG1)
GET {{baseUrl}}/listings/{{malmo[0].id}}/bookings

### FAIL: anna books her own listing -> 403
POST {{baseUrl}}/listings/{{are[0].id}}/bookings
Content-Type: application/json

{ "email": "anna@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 90 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 91 d}}", "guests": 1 }

### FAIL: anna edits sara's booking, which she can't see -> 404 (VG1, not 403: bookings are private)
PATCH {{baseUrl}}/bookings/{{seasideBookings[1].id}}
Content-Type: application/json

{ "guests": 1 }

### FAIL: anna deletes sara's booking -> 404 (VG1)
DELETE {{baseUrl}}/bookings/{{seasideBookings[1].id}}

### Anna deletes her own booking -> 204
DELETE {{baseUrl}}/bookings/{{annaBooking.id}}

### Log out anna, log in as erik -> 204, then 200
POST {{baseUrl}}/auth/logout

###
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "erik@stayfinder.test",
  "password": "password123"
}

### Erik owns Malmö, so he sees sara's two bookings on it -> 200 (VG1)
GET {{baseUrl}}/listings/{{malmo[0].id}}/bookings

### FAIL: erik (the owner) edits sara's booking on his listing -> 403 (VG1: the owner can only read)
PATCH {{baseUrl}}/bookings/{{seasideBookings[1].id}}
Content-Type: application/json

{ "guests": 1 }

### FAIL: erik (the owner) deletes sara's booking -> 403 (VG1)
