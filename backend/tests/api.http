# StayFinder API test calls, written for httpyac (VS Code extension "httpYac" or the CLI).
# Run all from the terminal in backend/: npx httpyac send tests/api.http --all
# Run top to bottom: httpyac keeps the session cookies between calls, like a browser.
# A "# @name x" call saves its JSON body as x, so later calls can use {{x.id}} or {{x[0].id}}.
# Every call has a comment with the expected status.

@baseUrl = http://localhost:3001

###############################################################################
# Auth (G1, G2)
###############################################################################

### Register a new user -> 201, Set-Cookie with the session
# A new email each run, so the file can be run again
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user{{$timestamp}}@stayfinder.test",
  "password": "password123"
}

### Who am I, right after register -> 200 with the email above
GET {{baseUrl}}/auth/me

### Log out -> 204, cookies cleared
POST {{baseUrl}}/auth/logout

### Who am I, after logout -> 401
GET {{baseUrl}}/auth/me

### Log in with the same account -> 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{register.email}}",
  "password": "password123"
}

### Who am I, after login -> 200
GET {{baseUrl}}/auth/me

### FAIL: register with an invalid email -> 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "password123"
}

### FAIL: log in with an invalid email -> 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "password123"
}

### FAIL: register with a too short password -> 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "short{{$timestamp}}@stayfinder.test",
  "password": "123"
}

### FAIL: register without a body -> 400
POST {{baseUrl}}/auth/register

### FAIL: register with a body that isn't JSON -> 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

hello

### FAIL: register an email that already exists -> 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{register.email}}",
  "password": "password123"
}

### FAIL: log in with the wrong password -> 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{register.email}}",
  "password": "wrongpassword"
}

### Log out again (end the session for the next calls) -> 204
POST {{baseUrl}}/auth/logout

### FAIL: who am I without a session -> 401
GET {{baseUrl}}/auth/me

### Log out when already logged out -> still 204 (harmless)
POST {{baseUrl}}/auth/logout

###############################################################################
# Listings (G4, G5, G6, G8, G14, VG1)
# Needs a fresh seed: supabase/seed/reset.sql, `npm run seed`, supabase/seed/past_booking.sql (see backend/README.md).
# Starts logged out (the auth section ends with a logout).
###############################################################################

### All listings, logged out -> 200, newest first
GET {{baseUrl}}/listings

### Filter on location, part of the name, any case -> 200, only the two Stockholm listings
GET {{baseUrl}}/listings?location=stock

### Filter on max price -> 200, only listings at 900 or less
GET {{baseUrl}}/listings?maxPrice=900

### Filter on guests -> 200, only listings for 4 or more guests
GET {{baseUrl}}/listings?guests=4

### Filter + sort ascending -> 200, Stockholm: 650 before 950
GET {{baseUrl}}/listings?location=stockholm&sort=price_asc

### Filter + sort descending -> 200, Stockholm: 950 before 650
GET {{baseUrl}}/listings?location=stockholm&sort=price_desc

### Erik's "Apartment in Haga" (its id and owner are used below) -> 200
# @name haga
GET {{baseUrl}}/listings?location=göteborg

### Erik's "Seaside house", which has a started booking (used for the 409 below) -> 200
# @name seaside
GET {{baseUrl}}/listings?location=visby

### Detail page -> 200
GET {{baseUrl}}/listings/{{haga[0].id}}

### FAIL: max price that isn't a number -> 400
GET {{baseUrl}}/listings?maxPrice=abc

### FAIL: zero guests -> 400
GET {{baseUrl}}/listings?guests=0

### FAIL: unknown sort -> 400
GET {{baseUrl}}/listings?sort=cheapest

### FAIL: listing that doesn't exist -> 404
GET {{baseUrl}}/listings/00000000-0000-4000-8000-000000000000

### FAIL: id that isn't a uuid -> 404
GET {{baseUrl}}/listings/not-a-uuid

### FAIL: create a listing logged out -> 401 (G6, API part)
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "title": "Should not be created",
  "location": "Nowhere",
  "price_per_night": 500,
  "max_guests": 2
}

### FAIL: update a listing logged out -> 401
PATCH {{baseUrl}}/listings/{{haga[0].id}}
Content-Type: application/json

{ "price_per_night": 1 }

### FAIL: delete a listing logged out -> 401
DELETE {{baseUrl}}/listings/{{haga[0].id}}

### Log in as anna -> 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "anna@stayfinder.test",
  "password": "password123"
}

### Create a listing, trying to make erik the owner -> 201, owner_id is still anna (VG1)
# @name newListing
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "title": "Test cottage",
  "description": "Made by the test file",
  "location": "Uppsala",
  "price_per_night": 700,
  "max_guests": 3,
  "owner_id": "{{haga[0].owner_id}}"
}

### Update your own listing -> 200 with price_per_night 750
PATCH {{baseUrl}}/listings/{{newListing.id}}
Content-Type: application/json

{ "price_per_night": 750 }

### FAIL: create with price 0 -> 400
# details.price_per_night: "Price must be at least 1 kr"
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "title": "Free stay",
  "location": "Uppsala",
  "price_per_night": 0,
  "max_guests": 2
}

### FAIL: create with 0 max guests -> 400
# details.max_guests: "Max guests must be at least 1"
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "title": "Nobody fits",
  "location": "Uppsala",
  "price_per_night": 500,
  "max_guests": 0
}

### FAIL: create without a title -> 400
# details.title: "Title is required"
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "location": "Uppsala",
  "price_per_night": 500,
  "max_guests": 2
}

### FAIL: create with a title of only spaces -> 400
# The API trims it first, so it counts as empty. details.title: "Title is required"
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "title": "   ",
  "location": "Uppsala",
  "price_per_night": 500,
  "max_guests": 2
}

### FAIL: create with a title of 101 characters -> 400
# details.title: "Title can be at most 100 characters"
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "title": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
  "location": "Uppsala",
  "price_per_night": 500,
  "max_guests": 2
}

### FAIL: create with a price that isn't a whole number -> 400
# details.price_per_night: "Price must be a whole number"
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "title": "Half price",
  "location": "Uppsala",
  "price_per_night": 1.5,
  "max_guests": 2
}

### FAIL: create without max guests -> 400
# details.max_guests: "Max guests must be a whole number"
POST {{baseUrl}}/listings
Content-Type: application/json

{
  "title": "No guests given",
  "location": "Uppsala",
  "price_per_night": 500
}

### FAIL: create with a body that isn't JSON -> 400
POST {{baseUrl}}/listings
Content-Type: application/json

hello

### FAIL: update with nothing to change -> 400
PATCH {{baseUrl}}/listings/{{newListing.id}}
Content-Type: application/json

{}

### FAIL: anna updates erik's listing -> 403 (VG1, the DB's update policy changes 0 rows)
PATCH {{baseUrl}}/listings/{{haga[0].id}}
Content-Type: application/json

{ "price_per_night": 1 }

### FAIL: anna deletes erik's listing -> 403 (VG1)
DELETE {{baseUrl}}/listings/{{haga[0].id}}

### Erik's listing is unchanged after the two calls above -> 200, price_per_night still 800
GET {{baseUrl}}/listings/{{haga[0].id}}

### FAIL: update a listing that doesn't exist -> 404
PATCH {{baseUrl}}/listings/00000000-0000-4000-8000-000000000000
Content-Type: application/json

{ "price_per_night": 1 }

### FAIL: delete a listing that doesn't exist -> 404
DELETE {{baseUrl}}/listings/00000000-0000-4000-8000-000000000000

### Delete your own listing -> 204
DELETE {{baseUrl}}/listings/{{newListing.id}}

### The deleted listing is gone -> 404
GET {{baseUrl}}/listings/{{newListing.id}}

### Log out anna, log in as erik -> 204, then 200
POST {{baseUrl}}/auth/logout

###
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "erik@stayfinder.test",
  "password": "password123"
}

### FAIL: erik deletes "Seaside house", which has a started booking -> 409
DELETE {{baseUrl}}/listings/{{seaside[0].id}}

### Log out erik -> 204
POST {{baseUrl}}/auth/logout

###############################################################################
# Bookings (G9, G10, G12, G14, VG1, VG2, VG3, VG5, VG6)
# Dates are relative to today ({{$datetime "YYYY-MM-DD" 60 d}} = today + 60 days),
# and every booking created here is deleted at the end, so the file can be run again.
# The overlap tests use bookings made in this file, not the seeded ones (their dates move with the seed day).
###############################################################################

### Erik's "Townhouse in Malmö" (1100/night, max 4 guests, no bookings) -> 200
# @name malmo
GET {{baseUrl}}/listings?location=malmö

### Anna's "Cabin by the slopes" (used for "can't book your own listing") -> 200
# @name are
GET {{baseUrl}}/listings?location=åre

### FAIL: list bookings logged out -> 401
GET {{baseUrl}}/listings/{{malmo[0].id}}/bookings

### FAIL: book logged out -> 401
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 60 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 63 d}}", "guests": 3 }

### FAIL: edit logged out -> 401
PATCH {{baseUrl}}/bookings/00000000-0000-4000-8000-000000000000
Content-Type: application/json

{ "guests": 1 }

### FAIL: delete logged out -> 401
DELETE {{baseUrl}}/bookings/00000000-0000-4000-8000-000000000000

### Log in as sara -> 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "sara@stayfinder.test",
  "password": "password123"
}

### Sara books Malmö, 3 nights, 3 guests -> 201, total_price 3300 (VG6: 3 x 1100), guest_id = sara
# @name saraBooking
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 60 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 63 d}}", "guests": 3 }

### Book with a fake price in the body -> 201, total_price 1100 (1 night), not 1 (VG6)
# @name pricedBooking
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 70 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 71 d}}", "guests": 1, "total_price": 1 }

### FAIL: zero guests -> 400, details.guests: "At least 1 guest is required" (G10)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 80 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 0 }

### FAIL: invalid email -> 400, details.email: "Enter a valid email address" (G10)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "not-an-email", "check_in": "{{$datetime "YYYY-MM-DD" 80 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 1 }

### FAIL: check-out before check-in -> 400, details.check_out: "Check-out must be after check-in" (G10)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 81 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 80 d}}", "guests": 1 }

### FAIL: a date that isn't YYYY-MM-DD -> 400, details.check_in: "Choose a check-in date" (G10)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "tomorrow", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 1 }

### FAIL: guests not a whole number -> 400, details.guests: "Guests must be a whole number" (G10)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 80 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 1.5 }

### FAIL: email missing -> 400, details.email: "Enter a valid email address" (G10)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "check_in": "{{$datetime "YYYY-MM-DD" 80 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 1 }

### FAIL: check-in missing -> 400, details.check_in: "Choose a check-in date" (G10)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 1 }

### FAIL: 5 guests, Malmö allows 4 -> 400 "This listing allows at most 4 guests" (VG3, checked in the DB)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 80 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 5 }

### FAIL: 5 guests, and the client claims the listing allows 10 -> 400 "This listing allows at most 4 guests"
# VG3: the DB reads max_guests from the listing row, so a max_guests sent in the body has no effect
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 80 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 5, "max_guests": 10 }

### FAIL: check-in yesterday -> 400 "Check-in date has already passed" (VG5, checked in the DB)
POST {{baseUrl}}/listings/{{malmo[0].id}}/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" -1 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 2 d}}", "guests": 1 }

### FAIL: book a listing that doesn't exist -> 404
POST {{baseUrl}}/listings/00000000-0000-4000-8000-000000000000/bookings
Content-Type: application/json

{ "email": "sara@stayfinder.test", "check_in": "{{$datetime "YYYY-MM-DD" 80 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 81 d}}", "guests": 1 }

### FAIL: list bookings of a listing that doesn't exist -> 404
GET {{baseUrl}}/listings/00000000-0000-4000-8000-000000000000/bookings

### Edit own booking onto dates that overlap its old ones -> 200, total_price still 3300 (VG2: no clash with itself)
PATCH {{baseUrl}}/bookings/{{saraBooking.id}}
Content-Type: application/json

{ "check_in": "{{$datetime "YYYY-MM-DD" 61 d}}", "check_out": "{{$datetime "YYYY-MM-DD" 64 d}}" }

### Edit to 4 nights -> 200, total_price 4400 (VG6: recomputed from the new dates)
PATCH {{baseUrl}}/bookings/{{saraBooking.id}}
Content-Type: application/json

{ "check_out": "{{$datetime "YYYY-MM-DD" 65 d}}" }

### FAIL: edit own booking to 5 guests, Malmö allows 4 -> 400 "This listing allows at most 4 guests" (VG3 on edit)
PATCH {{baseUrl}}/bookings/{{saraBooking.id}}
Content-Type: application/json

{ "guests": 5 }

### FAIL: edit with nothing to change -> 400
PATCH {{baseUrl}}/bookings/{{saraBooking.id}}
Content-Type: application/json

{}

### FAIL: un-cancel -> 400 (only "cancelled" is accepted)
PATCH {{baseUrl}}/bookings/{{saraBooking.id}}
Content-Type: application/json

{ "status": "active" }

### FAIL: cancel and edit in one call -> 400
PATCH {{baseUrl}}/bookings/{{saraBooking.id}}
Content-Type: application/json

{ "status": "cancelled", "guests": 2 }

### FAIL: edit a booking that doesn't exist -> 404
PATCH {{baseUrl}}/bookings/00000000-0000-4000-8000-000000000000
Content-Type: application/json

{ "guests": 1 }

### FAIL: delete a booking that doesn't exist -> 404
DELETE {{baseUrl}}/bookings/00000000-0000-4000-8000-000000000000

### Sara's bookings on "Seaside house" -> 200, two: [0] has already started (supabase/seed/past_booking.sql), [1] is in the future
# @name seasideBookings
GET {{baseUrl}}/listings/{{seaside[0].id}}/bookings

### FAIL: edit a booking that has already started -> 400 (VG5)
PATCH {{baseUrl}}/bookings/{{seasideBookings[0].id}}
Content-Type: application/json

{ "guests": 1 }

### FAIL: cancel a booking that has already started -> 400 (VG5)
PATCH {{baseUrl}}/bookings/{{seasideBookings[0].id}}
Content-Type: application/json

{ "status": "cancelled" }

### FAIL: delete a booking that has already started -> 400 (VG5)
DELETE {{baseUrl}}/bookings/{{seasideBookings[0].id}}

